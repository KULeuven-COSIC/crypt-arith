# =============================================================================
# Internal hw-server staging scripts — hard-coded to a private server layout
# and not meaningful to external users. Configure your own remote V80 flow
# via the V80_SERVER / V80_REMOTE_ROOT env vars consumed by run_remote_sim.py
# and run_remote_synth.py instead.
# =============================================================================
scripts/build_and_push_eval.py
scripts/push_testvectors.py

