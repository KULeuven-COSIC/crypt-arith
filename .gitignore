# =============================================================================
# Generator outputs (regenerable; large; not part of the source artifact)
#   - work/ holds per-scenario build_butterfly / build_ntt / build_bank runs
#   - eval_examples/ is the local mirror staged by scripts/build_and_push_eval.py
#   - versal_arith/versal_arith_generated/ is the default -output_dir of cli.py
#
# NOTE: versal_arith/ARITH2026_Evaluation_Examples/ is INTENTIONALLY tracked
#       — it ships the canonical RTL for the ARITH 2026 paper. Do not ignore.
# =============================================================================
work/
eval_examples/
versal_arith/versal_arith_generated/

# Stray top-level run logs (sometimes dropped next to work/ by the build scripts)
/*.log

# Zipped run directories. These are transfer artifacts of work/ (already
# ignored above) — regenerable, tens of MB each, and incompressible by git.
*.zip

